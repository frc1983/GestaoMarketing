{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketing-os-netfive",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-25",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "marketing-os", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "APP_ENV": "production", "AUTH_DISABLED": "true" }
}
